{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eonstream.org/schemas/account/assertion.v0.schema.json",
  "title": "EON Account assertion payload, v0",
  "description": "The decoded payload of an assertion; see docs/cryptography.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "aud",
    "sub",
    "iat",
    "exp",
    "kid"
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "iss": {
      "type": "string",
      "pattern": "^https?://[a-z0-9.-]+(:[0-9]{1,5})?$"
    },
    "aud": {
      "type": "string",
      "pattern": "^https?://[a-z0-9.-]+(:[0-9]{1,5})?$"
    },
    "sub": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 22,
      "maxLength": 22
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,30}[a-z0-9]$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "kid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
